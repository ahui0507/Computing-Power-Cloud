# 按现场节点地址修改 server_name 和 Traefik NodePort。
map $http_upgrade $platform_connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80 default_server;
    server_name REPLACE_NODE_INTERNAL_IP platform.local;
    root /var/www/platform-current;
    index index.html;
    client_max_body_size 100m;

    # 每次打开页面验证入口文件，避免发布后继续使用旧版认证和路由代码。
    location = /index.html {
        add_header Cache-Control "no-cache, must-revalidate" always;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8000/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 180s;
    }

    location /jupyter/ {
        proxy_pass http://REPLACE_NODE_INTERNAL_IP:31663;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $platform_connection_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
