# 数据库Secret示例
# 使用以下命令创建：
# kubectl create secret generic db-secret \
#   --from-literal=url='mysql+pymysql://platform_user:REPLACE_DB_PASSWORD@mysql-service:3306/computing_platform'

# JWT Secret示例
# 使用以下命令创建：
# kubectl create secret generic jwt-secret \
#   --from-literal=key='your-very-secret-key-change-in-production'

# 注意：生产环境必须使用强密码和密钥！

