server {
    listen 192.168.24.64:8082;
    server_name _;
    allow 192.168.24.63;
    deny all;
    location = /internal/telemetry {
        proxy_pass http://127.0.0.1:8000/internal/telemetry;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
    location / { return 404; }
}
