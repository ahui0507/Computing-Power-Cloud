# Approved SSH/HTTP multiplexing; installed by the reviewed rollout procedure.
# cpcloud_connection_upgrade is defined by the existing cpcloud.conf.
log_format cpcloud_shared_safe '$remote_addr [$time_local] "$request_method $uri $server_protocol" $status $body_bytes_sent';
server {
    listen 127.0.0.1:8081 proxy_protocol;
    server_name _;
    set_real_ip_from 127.0.0.1;
    real_ip_header proxy_protocol;
    allow 10.240.0.0/16;
    deny all;
    root /opt/computing-platform/current/frontend/dist;
    index index.html;
    client_max_body_size 100m;
    access_log /var/log/nginx/cpcloud-shared-access.log cpcloud_shared_safe;

    location /api/ {
        proxy_pass http://127.0.0.1:8000/;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Replace untrusted client-provided headers with the verified connection source.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $cpcloud_connection_upgrade;
        proxy_read_timeout 3600;
    }
    # Recheck the Traefik ClusterIP after rebuilding the cluster.
    # Requires 00-cpcloud-jupyter-log.conf, including when publishing is rolled back.
    location /jupyter/ {
        proxy_pass http://10.43.190.20:80;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $cpcloud_connection_upgrade;
        proxy_read_timeout 3600;
        proxy_buffering off;
        access_log /var/log/nginx/cpcloud-jupyter-access.log cpcloud_jupyter_safe;
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
}
