map $http_upgrade $cpcloud_connection_upgrade {
    default upgrade;
    '' close;
}
server {
    listen 127.0.0.1:8080;
    listen 192.168.24.64:8080;
    server_name localhost 127.0.0.1;
    root /opt/computing-platform/current/frontend/dist;
    index index.html;
    client_max_body_size 100m;
    # Confirmed client WLAN: 10.240.52.192/16 => 10.240.0.0/16.
    # Loopback remains available for node health checks and authenticated administration.
    allow 127.0.0.1;
    allow 10.240.0.0/16;
    deny all;
    location /api/ {
        proxy_pass http://127.0.0.1:8000/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $cpcloud_connection_upgrade;
        proxy_read_timeout 3600;
    }
    # Recheck the Traefik ClusterIP after rebuilding the cluster.
    location /jupyter/ {
        proxy_pass http://10.43.190.20:80;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $cpcloud_connection_upgrade;
        proxy_read_timeout 3600;
        proxy_buffering off;
        access_log /var/log/nginx/cpcloud-jupyter-access.log cpcloud_jupyter_safe;
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
}
