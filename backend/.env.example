# 应用与数据库
DEBUG=False
LOG_LEVEL=INFO
DATABASE_URL=mysql+pymysql://REPLACE_DB_USER:REPLACE_DB_PASSWORD@localhost:3306/computing_platform
DATABASE_ECHO=False
AUTO_INIT_DATABASE=true
DATABASE_STARTUP_TIMEOUT_SECONDS=60

# 兼容既有部署配置；账号由管理员创建，不使用邮件验证码。
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_USERNAME=REPLACE_REDIS_USERNAME
REDIS_PASSWORD=REPLACE_REDIS_PASSWORD
SMTP_HOST=smtp.exmail.qq.com
SMTP_PORT=465
SMTP_USE_SSL=True
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# JWT：必须显式配置已记录的密钥，空值和占位项不能启动服务。
SECRET_KEY=REPLACE_WITH_CONFIRMED_SECRET_AT_LEAST_32_CHARACTERS
INITIAL_ACCOUNT_PASSWORD=REPLACE_WITH_CONFIRMED_INITIAL_PASSWORD
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Account protection and optional queue / operational warnings
LOGIN_MAX_FAILURES=10
LOGIN_WINDOW_SECONDS=900
RESOURCE_QUEUE_TTL_HOURS=24
ADMIN_ALERTS_ENABLED=true
GPU_TEMPERATURE_ALERT_C=85
BACKUP_MAX_AGE_HOURS=48
BACKUP_ALERTS_ENABLED=true
WORKLOAD_EPHEMERAL_GIB_PER_GPU=40
RECONCILIATION_HEARTBEAT_FILE=
INSTANCE_SAFETY_ENABLED=true
INITIAL_ADMIN_EMAIL=REPLACE_ADMIN_EMAIL
# 首次安装和新建账号的密码从本地配置读取，不能使用源码中的默认值。

# 集群、镜像和共享工作目录
K8S_CONFIG_PATH=
K8S_NAMESPACE=default
K8S_API_SERVER=
K8S_REQUEST_TIMEOUT_SECONDS=10
K8S_DELETE_TIMEOUT_SECONDS=30
K8S_IMAGE_PULL_POLICY=Never
K8S_GPU_RUNTIME_CLASS=nvidia
# 实例独立内存文件系统，供 NCCL / 多进程 DataLoader 使用，按实际使用占用主机内存。
WORKLOAD_SHM_SIZE_LIMIT=1Gi
# Site compatibility option; frozen for each new instance. May reduce multi-GPU bandwidth.
WORKLOAD_NCCL_P2P_DISABLE=false
WORKLOAD_ISOLATION_ENABLED=false
# SHA256 of the reviewed namespace NetworkPolicy spec; required when enabled.
WORKLOAD_NETWORK_POLICY_SHA256=
# 节点先按百分比为系统预留，再按申请GPU数/节点总GPU数分配用户额度。
NODE_RESERVED_CPU_PERCENT=20
NODE_RESERVED_RAM_PERCENT=20
JUPYTER_COMMAND=jupyter-lab
WORKSPACE_PVC_NAME=platform-workspaces
WORKSPACE_GID=1000
STORAGE_ROOT=REPLACE_CONFIRMED_SHARED_DIRECTORY
STORAGE_QUOTA_ENABLED=false
STORAGE_QUOTA_MODE=fixed
DEFAULT_STORAGE_LIMIT_GIB=300
STORAGE_QUOTA_HELPER=/usr/local/sbin/platform-storage
DEFAULT_STORAGE_SHARE_PERCENT=10
STORAGE_WARNING_PERCENT=80
BACKUP_STATUS_FILE=/var/lib/images/platform-data/backup-status.json
MAX_UPLOAD_BYTES=104857600
# Compose 接入 K3s 时填写共享目录和控制节点 kubeconfig 路径。
WORKSPACE_ROOT_HOST=REPLACE_CONFIRMED_SHARED_DIRECTORY
KUBECONFIG_HOST_PATH=/etc/rancher/k3s/k3s.yaml

# 仅 Compose 部署需要；主机 systemd 部署不读取这些值。
COMPOSE_DATABASE_URL=mysql+pymysql://REPLACE_DB_USER:REPLACE_DB_PASSWORD@db:3306/computing_platform
MYSQL_USER=REPLACE_DB_USER
MYSQL_PASSWORD=REPLACE_DB_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_DB_ROOT_PASSWORD
REDIS_ACL_HOST_PATH=REPLACE_PRIVATE_REDIS_ACL_FILE

# 后台恢复与状态核对
RECONCILIATION_ENABLED=true
RECONCILIATION_INTERVAL_SECONDS=15
RECONCILIATION_BATCH_SIZE=50
# 必须大于 10 * K8S_REQUEST_TIMEOUT_SECONDS + K8S_DELETE_TIMEOUT_SECONDS。
OPERATION_LEASE_SECONDS=300
OPERATION_RETRY_SECONDS=10
WORKLOAD_STARTUP_TIMEOUT_SECONDS=900

# 工作负载访问
INGRESS_ENABLED=True
INGRESS_HOST=platform.local
INGRESS_CLASS=traefik
INGRESS_USE_TLS=False
# External Nginx terminates HTTPS while the cluster Ingress remains HTTP.
PUBLIC_HTTPS_ENABLED=False
# 留空使用 INGRESS_HOST；填写 nodes 表 ID 时使用对应节点 IP。
CONTROL_NODE_ID=
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# 基础按时计费
BILLING_ENABLED=True
DEFAULT_GPU_PRICE_V100=10.0
DEFAULT_GPU_PRICE_A100=5.0
DEFAULT_GPU_PRICE_RTX4090=15.0
DEFAULT_GPU_PRICE_K80=5.0

# 用户默认资源配额；可用余额不超过10元预警，欠费保留6小时后自动释放。
DEFAULT_MAX_USER_GPUS=8
# Enable when the website is reachable but instance NodePorts are not published.
SSH_TUNNEL_ENABLED=false
# Optional existing SSH entry, e.g. username@bastion.example.edu:64022.
# Users authenticate to the jump host with their existing node SSH credentials.
SSH_JUMP_HOST=
# Preferred: each instance gets a restricted forwarding identity and uses its own password.
SSH_GATEWAY_ENABLED=false
SSH_GATEWAY_ENDPOINT=
SSH_GATEWAY_HELPER=/usr/local/sbin/platform-ssh-gateway
DEFAULT_MAX_USER_INSTANCES=4
DEFAULT_LOW_BALANCE_AMOUNT=10
DEFAULT_LOW_BALANCE_MINUTES=0
DEBT_GRACE_HOURS=6
MINIMUM_BALANCE_MINUTES=1

# 支持SSH的镜像需包含OpenSSH服务；代理密钥通过运行时环境配置，不能提交Git。
SSH_ENABLED=False
WORKER_AGENT_URLS={}
WORKER_AGENT_TOKEN=
IMAGE_STORE_ROOT=/srv/platform-images
IMAGE_SAVE_TIMEOUT_SECONDS=1800

# 主机监控：先安装采集服务并确认上报，再开启新申请的新鲜度检查。
TELEMETRY_STALE_SECONDS=60
TELEMETRY_RETENTION_DAYS=7
TELEMETRY_ENFORCE_FRESHNESS=False
TELEMETRY_CLEANUP_ENABLED=True

# 可选服务
SMS_PROVIDER=local
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=REPLACE_MINIO_CREDENTIAL
MINIO_SECRET_KEY=REPLACE_MINIO_CREDENTIAL
MINIO_BUCKET=computing-platform
MINIO_SECURE=False
HARBOR_URL=
HARBOR_USERNAME=
HARBOR_PASSWORD=
HARBOR_PROJECT=computing-platform
