    "dayjs": "^1.11.10",
    "echarts": "^5.4.3",
    "element-plus": "^2.5.4",
    "pinia": "^2.1.7",
    "vue": "^3.4.15",
    "vue-echarts": "^6.6.9",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.2",
    "@vue/eslint-config-typescript": "^12.0.0",
    "eslint": "^8.55.0",
    "eslint-plugin-vue": "^9.19.2",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.0.0"
